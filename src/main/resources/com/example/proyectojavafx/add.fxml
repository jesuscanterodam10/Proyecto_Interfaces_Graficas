<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<VBox alignment="CENTER" spacing="20"
      stylesheets="@cs/add.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.proyectojavafx.Controller.Controller2">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20"/>
    </padding>

    <HBox alignment="CENTER" spacing="10">
        <TextField fx:id="idAdd" promptText="id (1,2,3...)" />
        <Button text="Id.Random" onAction="#numberRandom"/>

        <TextField fx:id="nameAdd" promptText="Nombre del juego..." />
        <TextField fx:id="storageMb" promptText="MB de almc (1,2,3...)" />
        <DatePicker fx:id="realaseDate" promptText="Fecha de lanzamiento" />
        <ComboBox fx:id="pegi" promptText="PEGI">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="18" />
                    <String fx:value="16" />
                    <String fx:value="12" />
                    <String fx:value="7" />
                    <String fx:value="3" />
                    <String fx:value="TP" />
                </FXCollections>
            </items>
        </ComboBox>
        <TextField fx:id="price" promptText="Precio" />
    </HBox>

    <HBox alignment="CENTER" spacing="20">
        <Button text="Insertar" onAction="#buttonForAdd"/>
        <Button text="Menú" onAction="#backButtonMenu"/>
    </HBox>

    <Label fx:id="userText" textFill="WHITE"/>

</VBox>