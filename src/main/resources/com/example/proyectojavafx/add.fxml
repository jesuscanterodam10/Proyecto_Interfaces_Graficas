<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="472.0" prefWidth="646.0" spacing="20" styleClass="add-panel" stylesheets="@cs/add.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyectojavafx.Controller.Controller2">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label styleClass="screen-title" text="INSERTAR VIDEOJUEGO" />

    <Separator styleClass="separator-line" />

    <HBox alignment="CENTER" spacing="10">

        <CheckBox fx:id="autoIdSwitch" onAction="#changerCheck" styleClass="modern-check" text="ID automático" />

        <TextField fx:id="idAdd" promptText="ID" styleClass="input-field" />

        <Button fx:id="idRandom" onAction="#numberRandom" styleClass="secondary-button" text="Aleatorio" />

    </HBox>

    <HBox alignment="CENTER" spacing="10">

        <TextField fx:id="nameAdd" prefWidth="250" promptText="Nombre del juego" styleClass="input-field" />

        <TextField fx:id="storageMb" promptText="Almacenamiento (MB)" styleClass="input-field" />

    </HBox>

    <HBox alignment="CENTER" spacing="10">

        <DatePicker fx:id="realaseDate" styleClass="input-field" />

        <ComboBox fx:id="pegi" promptText="PEGI" styleClass="input-field">

            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="18" />
                    <String fx:value="16" />
                    <String fx:value="12" />
                    <String fx:value="7" />
                    <String fx:value="3" />
                    <String fx:value="TP" />
                </FXCollections>
            </items>

        </ComboBox>

        <TextField fx:id="price" promptText="Precio (€)" styleClass="input-field" />

    </HBox>

    <Separator styleClass="separator-line" />

    <Button onAction="#buttonForAdd" prefWidth="200" styleClass="primary-button" text="INSERTAR" />

    <Button onAction="#backButtonMenu" prefWidth="200" styleClass="back-button" text="VOLVER AL MENÚ" />

    <Label fx:id="userText" styleClass="info-label" />

</VBox>
