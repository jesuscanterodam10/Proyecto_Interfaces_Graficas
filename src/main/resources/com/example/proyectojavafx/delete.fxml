<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER"
      prefHeight="181.0"
      prefWidth="217.0"
      spacing="18.0"
      stylesheets="@cs/deleteCs.css"
      styleClass="delete-panel"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.proyectojavafx.Controller.Controller2">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="ELIMINAR REGISTRO"
           styleClass="delete-title"/>

    <ComboBox fx:id="comboxIds"
              promptText="Selecciona ID"
              styleClass="input-field"/>

    <Button text="ELIMINAR"
            onAction="#buttonForDelete"
            styleClass="danger-button"/>

    <Button text="MENÚ"
            onAction="#backButtonMenu"
            styleClass="back-button"/>

    <Label fx:id="userText"
           styleClass="info-label"/>

</VBox>
