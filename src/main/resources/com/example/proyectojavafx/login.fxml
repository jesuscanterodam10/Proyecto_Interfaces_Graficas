<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="450.0" prefWidth="408.0" spacing="20.0" stylesheets="@cs/LoginCss.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyectojavafx.Controller.Controller1">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label text="login"
           style="-fx-font-size: 40px; -fx-text-fill: blue; -fx-font-weight: bold;" />
    <TextField fx:id="introUser" promptText="Usuario...." />
    <PasswordField fx:id="introPassword" promptText="Contraseña...." />
    <Label fx:id="confirm" />
    <Button onAction="#logButton" text="log in" />
    <Button onAction="#close" text="Salir" />
</VBox>
